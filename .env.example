# Copy to .env and fill in. NEVER commit .env.

# --- LLM (optional) ---------------------------------------------------------
# The pipeline runs with no key at all: app/llm/echo.py serves retrieval-only
# mode, so ingestion, retrieval, guardrails and eval are all demoable keyless.
#
# Fastest route: set ONE free-tier key below and nothing else. The base URL and
# model are filled in automatically by app/llm/free_tier.py.
#   Groq    - console.groq.com/keys      (default openai/gpt-oss-120b)
#   Gemini  - aistudio.google.com/apikey (default gemini-2.0-flash)
# Groq_MODEL pins a specific Groq model; the pinned model is verified working.
GROQ_API_KEY=
GROQ_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Any other OpenAI-compatible endpoint (OpenAI, Together, Ollama, LM Studio,
# a local vLLM server). All three lines are required together - there is no
# default model, because every provider names its models differently.
#   OpenAI proper:  https://api.openai.com/v1
#   Ollama locally: http://localhost:11434/v1
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Force a backend instead of letting app/llm sniff the environment.
# One of: env | free_tier | openai_compat | echo
# LLM_PROVIDER=env

# --- Runtime ----------------------------------------------------------------
# 1 = never contact huggingface.co. Set this on demo day once the model cache is
# warm, so a flaky network cannot stall startup.
HF_HUB_OFFLINE=0

LOG_LEVEL=INFO

# Salt for the one-way query hash written to logs/run.jsonl. Change it per run if
# you want to make log correlation non-reversible across deployments.
LOG_HASH_SALT=demo-salt
